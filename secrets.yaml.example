# Plantilla de secretos para este proyecto.
#
# Para crear el archivo cifrado:
#   1. Copia este archivo:      cp secrets.yaml.example secrets.yaml
#   2. Rellena los valores
#   3. Cífralo con SOPS:        sops --encrypt secrets.yaml > secrets.enc.yaml
#   4. Elimina el plano:        rm secrets.yaml
#
# Para editar los secretos ya cifrados:
#   sops secrets.enc.yaml
#
# Para migrar el .env existente a SOPS:
#   python modules/secretos.py migrar

# ── TMDB (The Movie Database) ───────────────────────────────────────────────
# Obtén tus credenciales en https://www.themoviedb.org/settings/api
# Usa TMDB_TOKEN (recomendado) O TMDB_API_KEY, no ambos a la vez.
TMDB_TOKEN: ""       # API Read Access Token (Bearer) — aparece como "Token de acceso a la lectura de la API v4"
TMDB_API_KEY: ""     # API Key (v3) — alternativa al token

# ── Música ──────────────────────────────────────────────────────────────────
SPOTIFY_CLIENT_ID: ""
SPOTIFY_CLIENT_SECRET: ""
LASTFM_API_KEY: ""
GENIUS_ACCESS_TOKEN: ""
MUSIXMATCH_API_KEY: ""
